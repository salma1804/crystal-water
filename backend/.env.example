# Copie ce fichier en ".env" (sans ".example") et remplis tes vraies valeurs.

# --- Supabase ---
# Settings > API dans ton tableau de bord Supabase :
#   SUPABASE_URL         -> "Project URL"
#   SUPABASE_SERVICE_KEY -> "service_role" (PAS la clé "anon" ici, celle-ci reste secrète côté serveur)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_KEY=VOTRE-CLE-SERVICE-ROLE

# --- Gemini (diagnostic IA) ---
# Obtenue sur https://aistudio.google.com/app/apikey
# Utilisée uniquement côté serveur (routes/diagnose.js) — ne jamais l'exposer côté frontend.
GEMINI_API_KEY=votre_cle_gemini_ici

PORT=4000
